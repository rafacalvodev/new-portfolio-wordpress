---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeServices from "../components/home/HomeServices.astro";
import HomeProjects from "../components/home/HomeProjects.astro";
import HomeAbout from "../components/home/HomeAbout.astro";
import HomeBlog from "../components/home/HomeBlog.astro";
// import CTA from "../components/CTA.astro";
import ContactSection from "../components/page/ContactSection.astro";

const title =
  "Rafael Calvo — Desarrollador web freelance | WordPress & Frontend";
const description =
  "Desarrollador web freelance especializado en WordPress y frontend. Diseño accesible, rápido y optimizado para pymes y ONGs. Mira mi portafolio y servicios.";
---

<DefaultLayout title={title} description={description}>
  <HomeHero />
  <HomeServices title="Estos son los servicios que ofrezco." />
  <HomeAbout />
  <HomeProjects />
  <HomeBlog />
  <ContactSection />
</DefaultLayout>
