---
import DefaultLayout from "../../layouts/DefaultLayout.astro";
import Pagination from "../../components/Pagination.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import VisitSite from "../../assets/icons/misc/CarbonArrowUpRight.svg";
import ContactSection from "../../components/page/ContactSection.astro";
import PageBanner from "../../components/page/PageBanner.astro";

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  const projects = await getCollection("projects");
  return paginate(projects, { pageSize: 6 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<"projects">>;
}

const { page } = Astro.props;
---

<DefaultLayout
  title="Portafolio — Proyectos de desarrollo web | Rafael Calvo"
  description="Casos de estudio y proyectos de diseño y desarrollo web para pymes y ONGs. Ejemplos y detalles de cada proyecto."
>
  <PageBanner
    title="Portafolio de Proyectos"
    description="Todos los proyectos que salen aquí son desarrollados por mí, desde el diseño hasta la implementación. Si quieres que tu proyecto sea desarrollado con la misma calidad y atención al detalle, no dudes en contactarme."
    class="portfolio-banner"
  />
  <section class="projects-section">
    <div class="container">
      <!-- <p>
        <em
          >Project {page.start + 1} through {page.end + 1} of {page.total} total projects</em
        >
      </p> -->
      <ul role="list" class="grid">
        {
          page.data.map((project) => (
            <li class="mb-4">
              <article class="card | flow">
                {project.data.image && (
                  <img
                    src={`/projects/${project.data.image}`}
                    alt={`${project.data.title} screenshot`}
                  />
                )}
                <h2>{project.data.title}</h2>
                <ul role="list" class="project-details | flow">
                  <li>
                    <strong>Stack:</strong> {project.data.stack.join(", ")}.
                  </li>
                  <li>
                    <strong>Tipo:</strong> {project.data.type.join(", ")}
                  </li>
                  <li>
                    <strong>Trabajo:</strong> {project.data.work.join(", ")}.
                  </li>
                </ul>
                <a class="button" href={project.data.link} target="_blank">
                  Visitar sitio Web <VisitSite />
                </a>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <div id="pagination" class="pagination">
    <div class="container flex">
      <Pagination
        basePath="/portafolio"
        previousPage={page.url.prev ? page.url.prev : null}
        nextPage={page.url.next ? page.url.next : null}
        currentPage={page.currentPage}
        totalPages={Math.ceil(page.total / page.size)}
      />
    </div>
  </div>

  <ContactSection />
</DefaultLayout>

<style lang="scss">
  .portfolio-banner {
    background-color: var(--blue-400);
    color: var(--gray-950);
  }
  .projects-section {
    margin-block-end: 2rem;

    .project-details {
      padding: 0;
    }

    .grid {
      --minimun: 30ch;
    }

    .pagination {
      margin-block-end: 2rem;
    }
  }
</style>
